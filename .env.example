# Structured Agents - Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# These variables configure where agents execute and how they connect
# to external systems. All are required unless marked optional.

# =============================================================================
# Remote Server (SSH)
# =============================================================================

# Hostname or IP of the remote build/development server
SAGENT_SSH_HOST="your-server-hostname"

# SSH username on the remote server
SAGENT_SSH_USER="your-username"

# Path to SSH private key (optional, defaults to ~/.ssh/id_ed25519)
SAGENT_SSH_KEY="~/.ssh/id_ed25519"

# SSH port (optional, defaults to 22)
SAGENT_SSH_PORT="22"

# Base directory on the remote server where all repos are cloned
SAGENT_WORKSPACE="/home/your-username/git"

# Set to "true" if you are running Cursor/agents directly ON the remote server
# (e.g. via Cursor SSH Remote). When true, agents skip SSH and run commands
# directly. When unset, agents auto-detect by comparing hostname to SAGENT_SSH_HOST.
# SAGENT_IS_REMOTE="true"

# =============================================================================
# Jira
# =============================================================================

# Jira instance URL
JIRA_SERVER_URL="https://issues.example.com"

# Jira username or email
JIRA_USERNAME="your-email@example.com"

# Jira API token or personal access token
JIRA_API_TOKEN=""

# =============================================================================
# GitLab
# =============================================================================

# GitLab instance URL
GITLAB_URL="https://gitlab.com"

# GitLab personal access token (needs 'api' scope)
GITLAB_TOKEN=""

# =============================================================================
# GitHub
# =============================================================================

# GitHub personal access token (needs 'repo' scope)
GITHUB_TOKEN=""

# =============================================================================
# Slack
# =============================================================================

# Slack Bot OAuth token (needs channels:history, channels:read, chat:write)
SLACK_BOT_TOKEN=""

# Slack webhook URL for simple notifications (optional)
SLACK_WEBHOOK_URL=""
